/* =====================================================
   BACKUP
===================================================== */

function backup(){

let backupData={

financeData:data,
settings:settingsData,
accountData:accountData,
language:lang,
currentMonth:current,
createdAt:new Date().toISOString()

};

let blob=new Blob(
[
JSON.stringify(
backupData,
null,
2
)
],
{
type:"application/json"
}
);

let url=
URL.createObjectURL(blob);

let a=
document.createElement("a");

a.href=url;

a.download=
"masrofi-backup-"+current+".json";

document.body.appendChild(a);

a.click();

a.remove();

URL.revokeObjectURL(url);

}


/* =====================================================
   RESTORE
===================================================== */

function restore(event){

let file=
event.target.files[0];

if(!file)return;

let reader=
new FileReader();

reader.onload=function(){

try{

let backupData=
JSON.parse(
reader.result
);

if(backupData.financeData)
data=backupData.financeData;

if(backupData.settings)
settingsData=backupData.settings;

if(backupData.accountData)
accountData=backupData.accountData;

if(backupData.language)
lang=backupData.language;

if(backupData.currentMonth)
current=backupData.currentMonth;

save();
saveSettings();
saveAccountData();

render();

alert(
lang==="ar"
?"تمت الاستعادة بنجاح ✅"
:"Restore completed successfully ✅"
);

}catch(e){

alert(
lang==="ar"
?"ملف النسخة الاحتياطية غير صالح."
:"Invalid backup file."
);

}

};

reader.readAsText(file);

}


/* =====================================================
   RESET ALL
===================================================== */

function resetAll(){

if(!confirm(
lang==="ar"
?"تحذير! سيتم حذف كل البيانات نهائياً. هل أنت متأكد؟"
:"Warning! All data will be permanently deleted. Continue?"
))return;

localStorage.removeItem("financeData");
localStorage.removeItem("settings");
localStorage.removeItem("accountData");

data={};

settingsData={
baseCurrency:"USD",
rates:{
USD:1,
EUR:1,
CAD:1,
LBP:1,
SYP:1
},
pinEnabled:false,
pin:""
};

accountData={
name:"",
email:""
};

current=
new Date().toISOString().slice(0,7);

render();

}


/* =====================================================
   SMART SPENDING
===================================================== */

function smartMessage(c){

let daysInMonth=
new Date(
Number(current.slice(0,4)),
Number(current.slice(5,7)),
0
).getDate();

let today=
new Date();

let sameMonth=
today.toISOString().slice(0,7)===current;

let day=
sameMonth
?
today.getDate()
:
daysInMonth;

let avg=
day>0
?
c.spent/day
:0;

let message="";

if(c.budget<=0){

message=
lang==="ar"
?"حدد ميزانية شهرية للحصول على تحليل ذكي."
:"Set a monthly budget to get smart analysis.";

}else if(c.spent>c.budget){

message=t("smartOver");

}else if(c.spent>=c.budget*.8){

message=t("smartWarning");

}else{

message=t("smartGood");

}

return{
daysInMonth,
day,
avg,
message
};

}
