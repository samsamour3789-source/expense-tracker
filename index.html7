/* =====================================================
   CALCULATIONS
===================================================== */

function calculateMonth(){

let m=monthData();

let income=
m.income
?
toBase(
m.income.amount,
m.income.currency
)
:0;

let budget=
m.budget
?
toBase(
m.budget.amount,
m.budget.currency
)
:0;

let baseBalance=
m.baseBalance
?
toBase(
m.baseBalance.amount,
m.baseBalance.currency
)
:0;

let savingsGoal=
m.savingsGoal
?
toBase(
m.savingsGoal.amount,
m.savingsGoal.currency
)
:0;

let fixed=
total(m.fixed);

let spent=
total(m.expenses);

let totalExpenses=
fixed+spent;

let balance=
income+
baseBalance-
totalExpenses;

let budgetRemaining=
budget-spent;

let currentSavings=
Math.max(
0,
balance
);

return{

income,
budget,
baseBalance,
savingsGoal,
fixed,
spent,
totalExpenses,
balance,
budgetRemaining,
currentSavings

};

}


/* =====================================================
   PREVIOUS MONTH SAVINGS
===================================================== */

function previousMonthKey(){

let d=new Date(
current+"-01T00:00:00"
);

d.setMonth(
d.getMonth()-1
);

return d.toISOString().slice(0,7);

}


function previousMonthSavings(){

let key=
previousMonthKey();

let m=data[key];

if(!m)return 0;

let income=
m.income
?
toBase(
m.income.amount,
m.income.currency
)
:0;

let base=
m.baseBalance
?
toBase(
m.baseBalance.amount,
m.baseBalance.currency
)
:0;

let fixed=
total(
m.fixed||[]
);

let expenses=
total(
m.expenses||[]
);

let remaining=
income+
base-
fixed-
expenses;

return Math.max(
0,
remaining
);

}


/* =====================================================
   AUTOMATIC NEXT MONTH BASE BALANCE
===================================================== */

function applyAutomaticSavings(){

let m=monthData();

let previous=
previousMonthSavings();

if(previous<=0)return;

let already=
m.baseBalance &&
Number(m.baseBalance.amount)>0;

if(already)return;

m.baseBalance={
amount:previous,
currency:settingsData.baseCurrency
};

save();

}


