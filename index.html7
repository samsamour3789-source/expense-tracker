<!DOCTYPE html>
<html lang="ar">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#111">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="مصروفي">
<link rel="manifest" href="./manifest.json">
<title>مصروفي 6.0</title>

<style>
*{
box-sizing:border-box;
font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display",
"Segoe UI",Arial,sans-serif
}

html{scroll-behavior:smooth}

body{
margin:0;
background:#181818;
color:#fff;
overflow-x:hidden
}

.container{
width:100%;
max-width:680px;
margin:auto;
padding:18px 14px 50px
}

h1{
text-align:center;
font-size:30px;
margin:8px 0
}

h2{
font-size:20px;
margin:0 0 14px
}

h3{
margin:18px 0 8px
}

.subtitle{
text-align:center;
color:#888;
margin-bottom:18px
}

.card{
background:#111;
border-radius:20px;
padding:18px;
margin-bottom:15px;
box-shadow:0 5px 18px #0005;
animation:cardIn .45s ease both;
overflow:hidden
}

@keyframes cardIn{
from{opacity:0;transform:translateY(12px)}
to{opacity:1;transform:translateY(0)}
}

.top{
display:grid;
grid-template-columns:1fr 1fr;
gap:8px;
margin-bottom:15px
}

button,input,select{
width:100%;
min-height:48px;
padding:13px 14px;
border-radius:13px;
border:1px solid #333;
background:#111;
color:#fff;
font-size:16px;
margin-bottom:10px;
outline:none
}

input:focus,select:focus{
border-color:#d71920;
box-shadow:0 0 0 2px #d7192030
}

button{
background:#d71920;
border:0;
font-weight:700;
cursor:pointer;
transition:.18s
}

button:active{
transform:scale(.97)
}

.secondary{
background:#eee;
color:#111
}

.goldBtn{background:#b38b18}
.blueBtn{background:#2459a8}
.greenBtn{background:#148c49}
.printBtn{background:#5d5d5d}

.balance{text-align:center}

.balance-number{
font-size:40px;
font-weight:900;
margin:5px;
letter-spacing:-1px
}

.small{
font-size:12px;
color:#888
}

.stats{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:8px;
margin-top:15px
}

.stat{
background:#181818;
border-radius:14px;
padding:14px 7px;
min-width:0
}

.stat-title{
font-size:12px;
color:#888
}

.stat-value{
font-weight:800;
margin-top:5px;
font-size:16px;
overflow:hidden;
text-overflow:ellipsis
}

.green{color:#20d06b}
.red{color:#ff4b4b}
.blue{color:#5797ff}
.gold{color:#f5c542}

.box{
background:#181818;
border-radius:15px;
padding:14px;
margin-top:10px;
overflow:hidden
}

.row{
display:flex;
justify-content:space-between;
align-items:center;
gap:10px;
padding:9px 0
}

.row span{color:#ccc}

.row strong{white-space:nowrap}

.big{
font-size:26px;
font-weight:800;
margin:5px 0
}

.progress{
height:10px;
background:#333;
border-radius:20px;
overflow:hidden;
margin:10px 0
}

.bar{
height:100%;
width:0;
border-radius:20px;
background:#d71920;
transition:width .7s ease
}

.savebar{background:#20d06b}

.warning,
.success,
.smart,
.alarm{
padding:12px;
border-radius:13px;
margin-top:12px
}

.warning{
background:#3b2d00;
color:#ffd85a;
display:none
}

.success{
background:#0d321d;
color:#58e58a;
display:none
}

.smart{
display:block;
background:#191d2d;
border:1px solid #293653;
color:#9ebcff
}

.alarm{
display:none;
background:#3a1113;
border:1px solid #7a2529;
color:#ff7272
}

.item{
display:flex;
justify-content:space-between;
align-items:center;
gap:12px;
padding:13px 0;
border-bottom:1px solid #292929
}

.left{
display:flex;
align-items:center;
gap:10px;
min-width:0;
flex:1
}

.icon{
width:42px;
height:42px;
min-width:42px;
border-radius:12px;
background:#222;
display:flex;
align-items:center;
justify-content:center;
font-size:20px
}

.name{
font-weight:700;
word-break:break-word
}

.amount{
font-weight:800;
white-space:nowrap;
text-align:right
}

.item>div:last-child{
flex-shrink:0;
text-align:right;
max-width:50%
}

.smallbtn{
width:auto;
min-height:34px;
padding:7px 10px;
font-size:12px;
margin:5px 2px 0
}

.edit{
background:#17263e;
color:#6fa4ff
}

.delete{
background:#401719;
color:#ff6969
}

.empty{
text-align:center;
color:#888;
padding:18px 10px
}

.months{
display:grid;
grid-template-columns:1fr 1fr;
gap:8px
}

.months button{margin:0}

.section-head{
display:flex;
justify-content:space-between;
align-items:center;
gap:10px;
margin-bottom:10px
}

.section-head h2{margin:0}

/* DAILY GROUPS */

.day-group{
background:#181818;
border-radius:16px;
padding:12px;
margin-bottom:12px;
border:1px solid #292929
}

.day-header{
display:flex;
justify-content:space-between;
align-items:center;
gap:10px;
padding-bottom:9px;
margin-bottom:5px;
border-bottom:1px solid #333
}

.day-title{
font-weight:800;
font-size:15px
}

.day-total{
font-weight:900;
color:#ff5b5b;
white-space:nowrap
}

.day-item{
display:flex;
justify-content:space-between;
gap:10px;
padding:10px 2px;
border-bottom:1px solid #242424
}

.day-item:last-child{border-bottom:0}

.day-note{
font-weight:700;
word-break:break-word
}

.day-meta{
font-size:11px;
color:#777;
margin-top:3px
}

.day-actions{
text-align:right;
white-space:nowrap
}

.history-total{
background:#181818;
border-radius:14px;
padding:13px;
margin-bottom:12px;
display:flex;
justify-content:space-between;
font-weight:800
}

/* CALENDAR */

.calendar-head{
display:grid;
grid-template-columns:repeat(7,1fr);
gap:4px;
margin-bottom:5px
}

.calendar-head div{
text-align:center;
color:#777;
font-size:11px;
padding:5px 0
}

.calendar{
display:grid;
grid-template-columns:repeat(7,1fr);
gap:4px
}

.day{
min-height:54px;
background:#181818;
border-radius:9px;
padding:5px;
position:relative;
cursor:pointer;
border:1px solid transparent
}

.day:hover{border-color:#444}

.day.emptyday{
background:transparent;
cursor:default
}

.day.today{border-color:#d71920}

.day-number{font-size:12px}

.day-total-calendar{
font-size:9px;
color:#ff5b5b;
margin-top:6px;
white-space:nowrap;
overflow:hidden
}

/* CHART */

.chart{
display:flex;
align-items:flex-end;
gap:7px;
height:160px;
padding:10px 3px;
overflow-x:auto
}

.chart-col{
min-width:34px;
height:140px;
display:flex;
flex-direction:column;
justify-content:flex-end;
align-items:center
}

.chart-bar{
width:24px;
min-height:3px;
background:#d71920;
border-radius:7px 7px 2px 2px
}

.chart-label{
font-size:9px;
color:#777;
margin-top:5px
}

.category-row{
display:flex;
align-items:center;
gap:8px;
margin:9px 0
}

.category-row .cat-name{
width:105px;
font-size:12px
}

.category-track{
flex:1;
height:9px;
background:#292929;
border-radius:20px;
overflow:hidden
}

.category-fill{
height:100%;
background:#d71920;
border-radius:20px
}

.category-money{
width:75px;
text-align:right;
font-size:12px
}

/* MODAL */

.modal{
display:none;
position:fixed;
inset:0;
background:#000a;
padding:20px;
z-index:50;
overflow-y:auto
}

.modalbox{
width:100%;
max-width:500px;
margin:50px auto;
background:#111;
padding:20px;
border-radius:20px;
box-shadow:0 15px 50px #000
}

.rtl{direction:rtl}

/* PIN */

#pinLock{
position:fixed;
inset:0;
background:#080808;
z-index:9999;
display:flex;
align-items:center;
justify-content:center;
padding:20px
}

.pinbox{
width:100%;
max-width:380px;
background:#111;
border-radius:25px;
padding:28px 22px;
text-align:center;
box-shadow:0 15px 60px #000
}

.pinlogo{
font-size:55px;
margin-bottom:5px
}

.pinbox h1{font-size:27px}

.pinbox p{color:#888}

.pininput{
text-align:center;
font-size:28px;
letter-spacing:12px;
font-weight:900;
margin-top:15px
}

.pinerror{
color:#ff4b4b;
min-height:22px;
font-size:13px
}

.pinbutton{
background:#d71920;
font-size:18px
}

#pinSettingsBox{display:none}

@media(max-width:500px){

.container{
padding:14px 10px 30px
}

.card{
padding:15px;
border-radius:18px
}

.balance-number{font-size:35px}

.big{font-size:23px}

}

@media(max-width:400px){

.stats{grid-template-columns:1fr}

.stat{
display:flex;
justify-content:space-between;
align-items:center;
padding:12px 14px
}

.stat-value{margin:0}

.day-item{flex-direction:column}

.day-actions{text-align:left}

}

/* PRINT */

@media print{

body{
background:#fff;
color:#000
}

.container{
max-width:none;
padding:10px
}

.card{
box-shadow:none;
background:#fff;
color:#000;
border:1px solid #ddd
}

.top,
#pinLock,
button,
input,
select,
.modal,
#settings,
#backupCard,
.no-print{
display:none!important
}

.small,
.day-meta,
.stat-title{
color:#555
}

.box,
.stat,
.day-group,
.history-total{
background:#f5f5f5;
color:#000
}

.red{color:#c00}
.green{color:#087a3c}
.blue{color:#174f9b}
.gold{color:#9a7400}

.print-title{display:block!important}

}
</style>
</head>

<body class="rtl">

<div id="pinLock">

<div class="pinbox">

<div class="pinlogo">🔐</div>

<h1 id="pinTitle">مصروفي</h1>

<p id="pinText">
أدخل رمز PIN للدخول
</p>

<input
id="pinInput"
type="password"
inputmode="numeric"
maxlength="6"
class="pininput"
placeholder="••••"
>

<div id="pinError" class="pinerror"></div>

<button
class="pinbutton"
onclick="checkPin()"
>
دخول
</button>

<div id="pinSetup">
<button
class="secondary"
onclick="setupPin()"
>
إعداد PIN
</button>
</div>

</div>
</div>
<div class="row">
<span id="accountNameLabel">اسم الحساب</span>
<strong id="accountName">-</strong>
</div>

<div class="row">
<span id="accountCurrencyLabel">عملة الحساب</span>
<strong id="accountCurrency">-</strong>
</div>

<div class="row">
<span id="accountBalanceLabel">رصيد الحساب</span>
<strong id="accountBalance">$0</strong>
</div>

</div>

<input
id="accountNameInput"
placeholder="اسم الحساب">

<input
type="number"
id="accountBalanceInput"
placeholder="الرصيد">

<select id="accountCurrencyInput">
<option value="USD">🇺🇸 USD</option>
<option value="EUR">🇪🇺 EUR</option>
<option value="CAD">🇨🇦 CAD</option>
<option value="LBP">🇱🇧 LBP</option>
<option value="SYP">🇸🇾 SYP</option>
</select>

<button
class="blueBtn"
onclick="saveAccount()"
id="accountBtn">
حفظ الحساب
</button>

<div id="accountList"></div>

</div>

</div>

<!-- EDIT MODAL -->

<div class="modal" id="editModal">

<div class="modalbox">

<h2 id="editTitle">✏️ تعديل المصروف</h2>

<input
type="number"
id="editAmount"
placeholder="المبلغ">

<select id="editCurrency">
<option value="USD">🇺🇸 USD</option>
<option value="EUR">🇪🇺 EUR</option>
<option value="CAD">🇨🇦 CAD</option>
<option value="LBP">🇱🇧 LBP</option>
<option value="SYP">🇸🇾 SYP</option>
</select>

<select id="editCategory">
<option value="🍔">🍔 Food</option>
<option value="☕">☕ Coffee</option>
<option value="🚗">🚗 Transportation</option>
<option value="🛍️">🛍️ Shopping</option>
<option value="🎉">🎉 Entertainment</option>
<option value="💊">💊 Health</option>
<option value="📌">📌 Other</option>
</select>

<input
id="editNote"
placeholder="الملاحظة">

<div class="top">

<button
onclick="saveEdit()"
id="editSaveBtn">
حفظ
</button>

<button
class="secondary"
onclick="closeEdit()"
id="editCancelBtn">
إلغاء
</button>

</div>

</div>

</div>

<script>

/* =========================
   MASROFI 6.0
   DATA
========================= */

const STORAGE_KEY="masrofi_6_data";

let data=JSON.parse(
localStorage.getItem(STORAGE_KEY)||"{}"
);

if(!data.months) data.months={};

if(!data.settings){
data.settings={
baseCurrency:"USD",
rates:{
EUR:0.92,
CAD:1.37,
LBP:89500,
SYP:13000
},
pinEnabled:false,
pin:""
};
}

if(!data.baseBalance){
data.baseBalance={
amount:0,
currency:"USD"
};
}

if(!data.account){
data.account={
name:"",
balance:0,
currency:"USD"
};
}

if(!data.savingsGoal){
data.savingsGoal={
amount:0,
currency:"USD"
};
}

let currentMonth=new Date();

let editIndex=-1;


/* =========================
   SAVE
========================= */

function saveData(){

localStorage.setItem(
STORAGE_KEY,
JSON.stringify(data)
);

}


/* =========================
   MONTH KEY
========================= */

function monthKey(date=currentMonth){

return date.getFullYear()+"-"+
String(date.getMonth()+1).padStart(2,"0");

}


/* =========================
   GET MONTH
========================= */

function getMonth(){

const key=monthKey();

if(!data.months[key]){

data.months[key]={
income:{
amount:0,
currency:"USD"
},

budget:{
amount:0,
currency:"USD"
},

savingsGoal:{
amount:0,
currency:"USD"
},

baseBalance:{
amount:0,
currency:"USD"
},

fixed:[],
daily:[]
};

}

return data.months[key];

}


/* =========================
   CURRENCY
========================= */

function rate(currency){

if(currency==="USD") return 1;

return Number(
data.settings.rates[currency]||1
);

}


/* Convert any currency to USD */

function toUSD(amount,currency){

amount=Number(amount)||0;

if(currency==="USD") return amount;

return amount/rate(currency);

}


/* Convert USD to base */

function fromUSD(amount){

const base=data.settings.baseCurrency;

return amount*rate(base);

}


/* Convert currency to base */

function toBase(amount,currency){

return fromUSD(
toUSD(amount,currency)
);

}


/* =========================
   FORMAT MONEY
========================= */

function money(amount,currency=data.settings.baseCurrency){

const value=Number(amount)||0;

const symbols={
USD:"$",
EUR:"€",
CAD:"CA$",
LBP:"ل.ل",
SYP:"ل.س"
};

const symbol=symbols[currency]||currency;

if(currency==="LBP"||currency==="SYP"){

return symbol+" "+
Math.round(value).toLocaleString();

}

return symbol+" "+
value.toLocaleString(
undefined,
{
minimumFractionDigits:2,
maximumFractionDigits:2
}
);

}


/* =========================
   CURRENT MONTH TOTALS
========================= */

function calculate(){

const m=getMonth();

const income=toBase(
m.income.amount,
m.income.currency
);

const budget=toBase(
m.budget.amount,
m.budget.currency
);

const goal=toBase(
m.savingsGoal.amount,
m.savingsGoal.currency
);

const base=toBase(
m.baseBalance.amount,
m.baseBalance.currency
);

let fixed=0;

m.fixed.forEach(x=>{
fixed+=toBase(
x.amount,
x.currency
);
});

let daily=0;

m.daily.forEach(x=>{
daily+=toBase(
x.amount,
x.currency
);
});

const total=fixed+daily;

const remaining=income+base-total;

const savings=Math.max(
0,
remaining-budget
);

return{
income,
budget,
goal,
base,
fixed,
daily,
total,
remaining,
savings
};

}


/* =========================
   TRANSLATIONS
========================= */

const translations={

ar:{

title:"💰 مصروفي",

subtitle:"إدارة ذكية لمصروفك وتوفيرك",

