/* =====================================================
   DAILY LIMIT
===================================================== */

function renderDailyLimit(){

let m=monthData();

let limit=
m.dailyLimit
?
toBase(
m.dailyLimit.amount,
m.dailyLimit.currency
)
:0;

let today=
getTodayTotal();

let remaining=
Math.max(
0,
limit-today
);

document.getElementById(
"dailyLimitTotal"
).textContent=
money(limit);

document.getElementById(
"todaySpent"
).textContent=
money(today);

document.getElementById(
"todayRemaining"
).textContent=
money(remaining);

let percent=
limit>0
?
Math.min(
100,
today/limit*100
)
:0;

document.getElementById(
"dailyProgress"
).style.width=
percent+"%";

document.getElementById(
"dailyLimitAmount"
).value=
m.dailyLimit
?
m.dailyLimit.amount
:"";

document.getElementById(
"dailyLimitCurrency"
).value=
m.dailyLimit
?
m.dailyLimit.currency
:"USD";

}


