===================================================== */

function renderMonth(){

let d=
new Date(
current+"-01T00:00:00"
);

document.getElementById(
"monthTitle"
).textContent=
d.toLocaleDateString(
lang==="ar"?"ar-LB":"en-US",
{
month:"long",
year:"numeric"
}
);

}


/* =====================================================
   TRANSLATE UI
===================================================== */

function translateUI(){

document.querySelectorAll(
"[data-i18n]"
).forEach(el=>{

let key=
el.getAttribute("data-i18n");

el.textContent=t(key);

});

document.querySelectorAll(
"[data-placeholder]"
).forEach(el=>{

let key=
el.getAttribute("data-placeholder");

el.placeholder=t(key);

});

}


/* =====================================================
   RENDER
===================================================== */

function render(){

applyAutomaticSavings();

buildMonthSelect();

renderMonth();

translateUI();

renderDashboard();

renderDailyLimit();

renderFixed();

renderHistory();

renderCalendar();

renderCategoryReport();

renderChart();

renderSmart();

renderAccount();

renderSettings();

checkAlarms();

}


/* =====================================================
   UPDATE
===================================================== */

function update(){

save();

render();

}


/* =====================================================
   ESCAPE HTML
===================================================== */

function escapeHtml(value){

return String(value??"")
.replaceAll("&","&amp;")
.replaceAll("<","&lt;")
.replaceAll(">","&gt;")
.replaceAll('"',"&quot;")
.replaceAll("'","&#039;");

}


/* =====================================================
   PRINT
===================================================== */

function printReport(){

window.print();

}


/* =====================================================
   INITIALIZE
===================================================== */

document.addEventListener(
"DOMContentLoaded",
()=>{

render();

if(
settingsData.pinEnabled &&
settingsData.pin
){

document.getElementById(
"pinLock"
).style.display="flex";

}else{

document.getElementById(
"pinLock"
).style.display="none";

}

}
);

</script>
<script>

/* =====================================================
   LANGUAGE
===================================================== */

function applyLanguage(){

document.documentElement.lang=lang;

document.body.classList.toggle(
"rtl",
lang==="ar"
);

const ids={

goal:"goalLabel",
savings:"currentSavingsLabel",

report:"reportTitle",

rates:"ratesTitle",
ratesHelp:"ratesHelp",
saveRates:"ratesBtn",

incomeMonth:"incomeTitle",
saveIncome:"incomeBtn",

budgetMonth:"budgetTitle",
budgetHelp:"budgetHelp",
saveBudget:"budgetBtn",

savingsGoalTitle:"savingsGoalTitle",
savingsGoalHelp:"savingsGoalHelp",
saveSavingsGoal:"savingsGoalBtn",

baseBalanceTitle:"baseBalanceTitle",
baseBalanceHelp:"baseBalanceHelp",
saveBaseBalance:"baseBalanceBtn",

fixedTitle:"fixedTitle",
fixedHelp:"fixedHelp",
addFixed:"fixedBtn",

daily:"dailyTitle",
addDaily:"dailyBtn",

history:"historyTitle",
print:"printBtn",
clear:"clearBtn",

editExpense:"editTitle",

smartTitle:"smartTitle",

calendar:"calendarTitle",
calendarHint:"calendarHint",

advanced:"advancedTitle",
category:"categoryTitle",
chart:"dailyChartTitle",

backup:"backupTitle",
backupHelp:"backupHelp",
backupBtn:"backupBtn",
reset:"resetBtn",

average:"dailyAverageLabel",
largest:"largestLabel",
days:"daysLeftLabel",

account:"accountTitle",
accountName:"accountNameLabel",
accountEmail:"accountEmailLabel",
saveAccount:"accountSaveBtn",

profile:"profileTitle",
profileName:"profileNameLabel",
profileCurrency:"profileCurrencyLabel",
profileExpenses:"profileExpensesLabel",
profileEdit:"profileEditBtn"

};

for(let k in ids){

let el=
document.getElementById(
ids[k]
);

if(
el &&
T[lang][k]!==undefined
){

el.textContent=
T[lang][k];

}

}


/* EXTRA REPORT LABELS */

document.getElementById(
"baseLabel"
).textContent=
lang==="ar"
?
"العملة الأساسية"
:
"Base Currency";


document.getElementById(
"rIncomeLabel"
).textContent=
lang==="ar"
?
"المدخول"
:
"Income";


document.getElementById(
"rFixedLabel"
).textContent=
lang==="ar"
?
"المصاريف الثابتة"
:
"Fixed Expenses";


document.getElementById(
"rDailyLabel"
).textContent=
lang==="ar"
?
"المصاريف اليومية"
:
"Daily Expenses";


