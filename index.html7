/* =====================================================
   CALENDAR
===================================================== */

function calendarData(){

let m=monthData();

let map={};

m.expenses.forEach(x=>{

if(!map[x.date]){
map[x.date]=0;
}

map[x.date]+=toBase(
x.amount,
x.currency
);

});

return map;

}


function renderCalendar(){

let el=
document.getElementById("calendar");

if(!el)return;

el.innerHTML="";

let parts=current.split("-");

let year=Number(parts[0]);
let month=Number(parts[1])-1;

let first=
new Date(year,month,1);

let last=
new Date(year,month+1,0);

let start=
first.getDay();

if(lang==="ar"){
start=(start+1)%7;
}

let map=calendarData();

for(let i=0;i<start;i++){

let empty=
document.createElement("div");

empty.className="day emptyday";

el.appendChild(empty);

}

for(let d=1;d<=last.getDate();d++){

let date=
year+"-"+
String(month+1).padStart(2,"0")+"-"+
String(d).padStart(2,"0");

let cell=
document.createElement("div");

cell.className="day";

if(date===
new Date().toISOString().slice(0,10)){

cell.classList.add("today");

}

cell.innerHTML=
`
<div class="day-number">${d}</div>
<div class="day-total-calendar">
${map[date] ? money(map[date]) : ""}
</div>
`;

cell.onclick=()=>showDayExpenses(date);

el.appendChild(cell);

}

}


function showDayExpenses(date){

let list=
monthData().expenses.filter(
x=>x.date===date
);

if(!list.length){

alert(
lang==="ar"
?"لا يوجد مصاريف بهذا اليوم."
:"No expenses on this day."
);

return;

}

let totalAmount=0;

let text=
lang==="ar"
?"مصاريف "+date+":\n\n"
:"Expenses "+date+":\n\n";

list.forEach(x=>{

let value=
toBase(
x.amount,
x.currency
);

totalAmount+=value;

text+=
(x.category||"")+
" "+
(x.note||"")+
" — "+
money(value)+
"\n";

});

text+=
"\n"+
(lang==="ar"?"المجموع: ":"Total: ")+
money(totalAmount);

alert(text);

}


/* =====================================================
   CATEGORY REPORT
===================================================== */

function categoryReport(){

let map={};

monthData().expenses.forEach(x=>{

let cat=x.category||"📌";

if(!map[cat]){
map[cat]=0;
}

map[cat]+=toBase(
x.amount,
x.currency
);

});

monthData().fixed.forEach(x=>{

let cat=x.category||"📌";

if(!map[cat]){
map[cat]=0;
}

map[cat]+=toBase(
x.amount,
x.currency
);

});

return map;

}


function renderCategories(){

let el=
document.getElementById("categories");

if(!el)return;

let map=categoryReport();

let entries=
Object.entries(map)
.sort((a,b)=>b[1]-a[1]);

if(!entries.length){

el.innerHTML=
`<div class="empty">
${lang==="ar"?"لا توجد مصاريف":"No expenses"}
</div>`;

return;

}

let max=
entries[0][1];

el.innerHTML=
entries.map(([cat,value])=>{

let percent=
max>0
?
(value/max)*100
:0;

return `
<div class="category-row">

<div class="cat-name">${cat}</div>

<div class="category-track">
<div
class="category-fill"
style="width:${percent}%">
</div>
</div>

<div class="category-money">
${money(value)}
</div>

</div>
`;

}).join("");

}


/* =====================================================
   DAILY CHART
===================================================== */

function renderChart(){

let el=
document.getElementById("chart");

if(!el)return;

let parts=current.split("-");

let year=Number(parts[0]);
let month=Number(parts[1])-1;

let days=
new Date(year,month+1,0).getDate();

let totals=[];

for(let d=1;d<=days;d++){

let date=
year+"-"+
String(month+1).padStart(2,"0")+"-"+
String(d).padStart(2,"0");

let totalDay=0;

monthData().expenses
.filter(x=>x.date===date)
.forEach(x=>{

totalDay+=toBase(
x.amount,
x.currency
);

});

totals.push(totalDay);

}

let max=
Math.max(...totals,1);

el.innerHTML=
totals.map((value,index)=>{

let height=
(value/max)*120;

return `
<div class="chart-col">

<div
class="chart-bar"
style="height:${Math.max(3,height)}px"
title="${money(value)}">
</div>

<div class="chart-label">
${index+1}
</div>

</div>
`;

}).join("");

}


/* =====================================================
   SMART SPENDING
===================================================== */

function renderSmart(c){

let el=
document.getElementById("smartText");

if(!el)return;

let parts=current.split("-");

let year=Number(parts[0]);
let month=Number(parts[1])-1;

let daysInMonth=
new Date(year,month+1,0).getDate();

let today=new Date();

let activeDays=
today.toISOString().slice(0,7)===current
?
today.getDate()
:
daysInMonth;

let avg=
activeDays>0
?
c.spent/activeDays
:0;

let largest=0;

monthData().expenses.forEach(x=>{

let value=
toBase(
x.amount,
x.currency
);

if(value>largest){
largest=value;
}

});

document.getElementById(
"smartAverage"
).textContent=
money(avg);

document.getElementById(
"smartLargest"
).textContent=
money(largest);

document.getElementById(
"smartDays"
).textContent=
Math.max(
0,
daysInMonth-activeDays
);

let message="";

if(c.budget<=0){

message=
lang==="ar"
?"حدد ميزانية شهرية حتى أعطيك تحليلاً أدق."
:"Set a monthly budget for a better analysis.";

}else if(c.spent>c.budget){

message=
lang==="ar"
?"⚠️ تجاوزت ميزانية المصروف الشهرية."
:"⚠️ You exceeded your monthly spending budget.";

}else if(c.spent>=c.budget*.8){

message=
lang==="ar"
?"⚠️ انتبه، اقتربت من حد الميزانية."
:"⚠️ Careful, you are close to your budget limit.";

}else{

message=
lang==="ar"
?"✅ مصروفك ضمن الحدود الجيدة."
:"✅ Your spending is within a good range.";

}

el.textContent=message;

}


/* =====================================================
   ALARMS
===================================================== */

function checkAlarms(){

let c=
calculateMonth();

let warning=
document.getElementById("warning");

let success=
document.getElementById("success");

let alarm=
document.getElementById("alarm");

if(!warning||!success||!alarm)return;

warning.style.display="none";
success.style.display="none";
alarm.style.display="none";

if(c.budget>0 && c.spent>c.budget){

warning.style.display="block";

warning.textContent=
lang==="ar"
?"⚠️ لقد تجاوزت ميزانية المصروف."
:"⚠️ You exceeded your spending budget.";

}

if(c.savingsGoal>0 && c.balance>=c.savingsGoal){

success.style.display="block";

success.textContent=
lang==="ar"
?"🎉 وصلت إلى هدف التوفير!"
:"🎉 You reached your savings goal!";

}

if(c.budget>0 && c.spent>=c.budget*.9){

alarm.style.display="block";

alarm.textContent=
lang==="ar"
?"🚨 تنبيه: بقي أقل من 10% من ميزانية المصروف."
:"🚨 Alert: less than 10% of your spending budget remains.";

}

}


/* =====================================================
   MONTHLY AUTO SAVING
===================================================== */

function calculatePreviousMonth(key){

let m=data[key];

if(!m){

return{
income:0,
base:0,
fixed:0,
spent:0,
remaining:0,
savingsGoal:0
};

}

let income=
m.income
?
toBase(
m.income.amount,
m.income.currency
)
:0;

let base=
m.baseBalance
?
toBase(
m.baseBalance.amount,
m.baseBalance.currency
)
:0;

let fixed=
total(m.fixed||[]);

let spent=
total(m.expenses||[]);

let remaining=
income+
base-
fixed-
spent;

let goal=
m.savingsGoal
?
toBase(
m.savingsGoal.amount,
m.savingsGoal.currency
)
:0;

return{
income,
base,
fixed,
spent,
remaining,
savingsGoal:goal
};

}


function autoCarrySavings(){

let previousKey=
previousMonthKey();

let previous=
calculatePreviousMonth(
previousKey
);

let m=monthData();

if(
!m.baseBalance ||
Number(m.baseBalance.amount)===0
){

let amount=0;

if(previous.savingsGoal>0){

amount=
Math.min(
Math.max(0,previous.remaining),
previous.savingsGoal
);

}else{

amount=
Math.max(
0,
previous.remaining
);

}

if(amount>0){

m.baseBalance={
amount:fromUSD(amount),
currency:settingsData.baseCurrency
};

save();

}

}

}
document.getElementById(
"dailyAverage"
).textContent=money(average);

document.getElementById(
"largestExpense"
).textContent=money(largest);

document.getElementById(
"daysLeft"
).textContent=daysLeft;

let smart=
document.getElementById("smartMessage");

if(budget<=0){

smart.textContent=t("setBudget");

}else if(daily>budget){

smart.textContent=t("smartOver");

}else if(daily>=budget*.8){

smart.textContent=t("smartWarning");

}else{

smart.textContent=t("smartGood");

}

}


/* =====================================================
   HISTORY
===================================================== */

function renderHistory(){

let box=
document.getElementById("history");

if(!box)return;

let expenses=
[...monthData().expenses]
.sort(
(a,b)=>
new Date(b.date)-
new Date(a.date)
);

if(!expenses.length){

box.innerHTML=
`<div class="empty">
${t("noExpenses")}
</div>`;

return;

}

let totalAmount=
total(expenses);

let html=`

<div class="history-total">

<span>${t("totalExpenses")}</span>

<strong>
${money(totalAmount)}
</strong>

</div>

`;

expenses.forEach(x=>{

let date=
new Date(x.date);

let dateText=
date.toLocaleDateString(
lang==="ar"?"ar-LB":"en-US",
{
day:"numeric",
month:"short",
year:"numeric"
}
);

let timeText=
date.toLocaleTimeString(
lang==="ar"?"ar-LB":"en-US",
{
hour:"2-digit",
minute:"2-digit"
}
);

html+=`

<div class="item">

<div class="left">

<div class="icon">
${x.category||"📌"}
</div>

<div>

<div class="name">
${escapeHtml(
x.note||t("dailyExpense")
)}
</div>

<div class="small">
${dateText} · ${timeText}
</div>

</div>

</div>

<div>

<div class="amount">
${money(x.amount,x.currency)}
</div>

<button
class="smallbtn edit"
onclick="editDaily(${x.id})">
${t("edit")}
</button>

<button
class="smallbtn delete"
onclick="deleteDaily(${x.id})">
${t("delete")}
</button>

</div>

</div>

`;

});

box.innerHTML=html;

}


/* =====================================================
   FIXED LIST
===================================================== */

function renderFixed(){

let box=
document.getElementById("fixedList");

if(!box)return;

let list=
monthData().fixed;

if(!list.length){

box.innerHTML=
`<div class="empty">
${t("noFixed")}
</div>`;

return;

}

box.innerHTML=
list.map(x=>`

<div class="item">

<div class="left">

<div class="icon">
${x.category||"🏠"}
</div>

<div>

<div class="name">
${escapeHtml(x.name)}
</div>

<div class="small">
${x.category||""}
</div>

</div>

</div>

<div>

<div class="amount">
${money(x.amount,x.currency)}
</div>

<button
class="smallbtn delete"
onclick="deleteFixed(${x.id})">
${t("delete")}
</button>

</div>

</div>

`).join("");

}


