/* =====================================================
   PIN
===================================================== */

function checkPin(){

let input=
document.getElementById("pinInput").value;

if(!settingsData.pinEnabled){

document.getElementById("pinLock").style.display="none";
return;

}

if(!settingsData.pin){

document.getElementById("pinLock").style.display="none";
return;

}

if(input===settingsData.pin){

document.getElementById("pinLock").style.display="none";

}else{

document.getElementById("pinError").textContent=
lang==="ar"
?"رمز PIN غير صحيح."
:"Incorrect PIN.";

document.getElementById("pinInput").value="";

}

}


function setupPin(){

let pin=
document.getElementById("pinInput").value.trim();

if(!/^\d{4,6}$/.test(pin)){

document.getElementById("pinError").textContent=
lang==="ar"
?"أدخل PIN من 4 إلى 6 أرقام."
:"Enter a 4–6 digit PIN.";

return;

}

settingsData.pin=pin;
settingsData.pinEnabled=true;

saveSettings();

document.getElementById("pinLock").style.display="none";

}


