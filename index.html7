/* =========================
   BASE BALANCE FOR MONTH
========================= */

function ensureMonthlyBaseBalance(){

const key=monthKey();

const m=getMonth();

if(key==="") return;

if(!m.baseBalance.amount){

const previous=new Date(
currentMonth.getFullYear(),
currentMonth.getMonth()-1,
1
);

const previousKey=
previous.getFullYear()+"-"+
String(previous.getMonth()+1).padStart(2,"0");

const prev=data.months[previousKey];

if(prev){

const prevCalc=calculatePreviousMonth(
previousKey
);

const saved=prevCalc.savings;

const goal=toUSD(
prev.savingsGoal.amount,
prev.savingsGoal.currency
);

const amountUSD=
Math.max(0,saved);

if(amountUSD>0){

m.baseBalance.amount=
fromUSD(amountUSD);

m.baseBalance.currency=
data.settings.baseCurrency;

}

}

}

}
