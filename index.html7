:
"Cancel";


/* PLACEHOLDERS */

document.getElementById(
"accountName"
).placeholder=
lang==="ar"
?
"اسمك"
:
"Your name";


document.getElementById(
"accountEmail"
).placeholder=
lang==="ar"
?
"البريد الإلكتروني"
:
"Email";


update();

}


/* =====================================================
   SETTINGS
===================================================== */

function loadSettings(){

if(!settingsData.rates)
settingsData.rates={};

if(!settingsData.rates.USD)
settingsData.rates.USD=1;

if(!settingsData.rates.EUR)
settingsData.rates.EUR=1;

if(!settingsData.rates.CAD)
settingsData.rates.CAD=1;

if(!settingsData.rates.LBP)
settingsData.rates.LBP=1;

if(!settingsData.rates.SYP)
settingsData.rates.SYP=1;

if(!settingsData.baseCurrency)
settingsData.baseCurrency="USD";


document.getElementById(
"baseCurrency"
).value=
settingsData.baseCurrency;


document.getElementById(
"eur"
).value=
settingsData.rates.EUR||"";


document.getElementById(
"cad"
).value=
settingsData.rates.CAD||"";


document.getElementById(
"lbp"
).value=
settingsData.rates.LBP||"";


document.getElementById(
"syp"
).value=
settingsData.rates.SYP||"";


document.getElementById(
"pinEnabled"
).value=
settingsData.pinEnabled===false
?
"no"
:
"yes";


document.getElementById(
"pinSettingsBox"
).style.display=
settingsData.pinEnabled===false
?
"none"
:
"block";

}


/* =====================================================
   RATES
===================================================== */

function saveRates(){

let eur=
Number(
document.getElementById(
"eur"
).value
);

let cad=
Number(
document.getElementById(
"cad"
).value
);

let lbp=
Number(
document.getElementById(
"lbp"
).value
);

let syp=
Number(
document.getElementById(
"syp"
).value
);


if(
eur<=0||
cad<=0||
lbp<=0||
syp<=0
){

alert(t("valid"));

return;

}


settingsData.rates={

USD:1,
EUR:eur,
CAD:cad,
LBP:lbp,
SYP:syp

};


saveSettings();

update();


alert(
lang==="ar"
?
"تم حفظ أسعار الصرف ✅"
:
"Exchange rates saved ✅"
);

}


function changeBase(){

settingsData.baseCurrency=
document.getElementById(
"baseCurrency"
).value;

saveSettings();

update();

}


/* =====================================================
   START
===================================================== */

loadSettings();

monthData();

renderAccount();

applyLanguage();

showPinLock();


if("serviceWorker" in navigator){

window.addEventListener(
"load",
()=>{

navigator.serviceWorker
.register(
"./service-worker.js"
)
.catch(
()=>{}
);

}

);

}

</script>

</body>
