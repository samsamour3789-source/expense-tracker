/* MAIN UPDATE */

function update(){

months();

let m=monthData();

let income=getIncomeTotal(m);

let fixed=total(m.fixed);
let daily=total(m.expenses);
let expenses=fixed+daily;

let budget=
m.budget
?
toBase(m.budget.amount,m.budget.currency)
:
0;

let carryover=Number(m.carryover)||0;

/*
ميزانية الشهر المتاحة =
ميزانية الشهر الحالي
+
الباقي المرحل من الشهر السابق.
*/

let availableBudget=budget+carryover;

let goal=getLegacyGoalBase(m);

if(goal>0){

m.savingGoal={
amount:goal,
currency:settingsData.baseCurrency
};

save();

}

/* BASE SAVINGS */

let baseSavings=
m.baseSavings
?
toBase(
m.baseSavings.amount,
m.baseSavings.currency
)
:
0;

let previousGoal=0;

let previous=data[previousMonthKey(current)];

if(previous && previous.savingGoal){

previousGoal=toBase(
previous.savingGoal.amount,
previous.savingGoal.currency
);

}

let balance=
income+
carryover-
fixed-
daily-
goal;

let budgetLeft=
availableBudget-daily;

let budgetPct=
availableBudget>0
?
daily/availableBudget*100
:
0;

let savings=
Math.max(
0,
income+
carryover-
fixed-
daily
);

let savingPct=
goal>0
?
savings/goal*100
:
0;

document.getElementById("balance").textContent=money(balance);
document.getElementById("income").textContent=money(income);
document.getElementById("fixed").textContent=money(fixed);
document.getElementById("spent").textContent=money(daily);

document.getElementById("currencyText").textContent=
t("base")+" "+settingsData.baseCurrency;

document.getElementById("budgetValue").textContent=
money(availableBudget);

document.getElementById("spentValue").textContent=
money(daily);

document.getElementById("remainingValue").textContent=
money(Math.max(0,budgetLeft));

document.getElementById("budgetBar").style.width=
Math.min(100,Math.max(0,budgetPct))+"%";

document.getElementById("budgetPercent").textContent=
Math.round(budgetPct)+"%";

document.getElementById("goalValue").textContent=
money(goal);

document.getElementById("savingsValue").textContent=
money(savings);

document.getElementById("savingBar").style.width=
Math.min(100,Math.max(0,savingPct))+"%";

document.getElementById("savingPercent").textContent=
Math.round(savingPct)+"%";

document.getElementById("rIncome").textContent=money(income);
document.getElementById("rFixed").textContent=money(fixed);
document.getElementById("rDaily").textContent=money(daily);
document.getElementById("rTotal").textContent=money(expenses);
document.getElementById("rGoal").textContent=money(goal);
document.getElementById("rBalance").textContent=money(balance);
document.getElementById("rSavings").textContent=money(savings);

document.getElementById("baseSavingsValue").textContent=
money(baseSavings);

document.getElementById("previousGoalValue").textContent=
money(previousGoal);

document.getElementById("totalSavedValue").textContent=
money(baseSavings);

document.getElementById("incomeSaved").textContent=
income>0
?
t("income")+": "+money(income)
:
"";

document.getElementById("budgetSaved").textContent=
m.budget
?
t("budget")+": "+
money(m.budget.amount,m.budget.currency)
:
"";

let w=document.getElementById("warning");
let s=document.getElementById("success");

w.style.display="none";
s.style.display="none";

if(availableBudget>0){

if(daily>availableBudget){

w.textContent=t("over");
w.style.display="block";

}else if(daily>=availableBudget*.85){

w.textContent=t("low");
w.style.display="block";

}else{

s.textContent=t("good");
s.style.display="block";

}
}

renderFixed();
renderHistory();
renderIncomeSources();
renderGoals();
renderDebts();
renderCalendar();
renderCategoryReport();
renderChart();
renderSmart();
renderComparison();
renderAccount();
checkAlarms();
}


