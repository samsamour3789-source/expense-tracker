/* SMART */

function renderSmart(){

let m=monthData();

let daily=total(m.expenses);

let budget=
m.budget
?
toBase(m.budget.amount,m.budget.currency)
:
0;

let now=new Date();
let parts=current.split("-").map(Number);

let year=parts[0];
let month=parts[1];

let daysInMonth=new Date(year,month,0).getDate();

let currentRealMonth=
now.getFullYear()+"-"+
String(now.getMonth()+1).padStart(2,"0");

let daysPassed=
current===currentRealMonth
?
now.getDate()
:
daysInMonth;

let average=daysPassed>0?daily/daysPassed:0;

let largest=0;

m.expenses.forEach(x=>{
largest=Math.max(
largest,
toBase(x.amount,x.currency)
);
});

let daysLeft=
current===currentRealMonth
?
Math.max(0,daysInMonth-now.getDate())
:
0;

document.getElementById("dailyAverage").textContent=money(average);
document.getElementById("largestExpense").textContent=money(largest);
document.getElementById("daysLeft").textContent=daysLeft;

let message=t("smartGood");

if(budget>0){

if(daily>budget)
message=t("smartOver");

else if(daily>=budget*.85)
message=t("smartWarning");
}

document.getElementById("smartMessage").textContent=message;

renderSmartAlerts();
}

function renderSmartAlerts(){

let box=document.getElementById("smartAlerts");
let m=monthData();

let alerts=[];

let spent=total(m.expenses);

let budget=
m.budget
?
toBase(m.budget.amount,m.budget.currency)
:
0;

if(budget>0){

let percent=spent/budget*100;

if(percent>=100){

alerts.push(
lang==="ar"
?
"🚨 تجاوزت الميزانية الشهرية."
:
"🚨 Monthly budget exceeded."
);

}else if(percent>=85){

alerts.push(
lang==="ar"
?
"⚠️ بقي أقل من 15% من ميزانية المصروف."
:
"⚠️ Less than 15% of the spending budget remains."
);

}
}

let previous=data[previousMonthKey(current)];

if(previous&&Array.isArray(previous.expenses)){

let previousCategories={};
let currentCategories={};

previous.expenses.forEach(x=>{
previousCategories[x.category]=
(previousCategories[x.category]||0)+
toBase(x.amount,x.currency);
});

m.expenses.forEach(x=>{
currentCategories[x.category]=
(currentCategories[x.category]||0)+
toBase(x.amount,x.currency);
});

Object.keys(currentCategories).forEach(cat=>{

let old=previousCategories[cat]||0;
let now=currentCategories[cat];

if(old>0&&now>old*1.5){

alerts.push(
lang==="ar"
?
"📈 زيادة كبيرة في مصروف "+cat+" مقارنة بالشهر الماضي."
:
"📈 Large increase in "+cat+" spending compared with last month."
);

}
});
}

let largest=0;

m.expenses.forEach(x=>{
largest=Math.max(
largest,
toBase(x.amount,x.currency)
);
});

if(budget>0&&largest>budget*.25){

alerts.push(
lang==="ar"
?
"💡 يوجد مصروف كبير نسبياً مقارنة بميزانية الشهر."
:
"💡 One expense is relatively large compared with your monthly budget."
);

}

let goal=getLegacyGoalBase(m);

if(goal>0){

let income=getIncomeTotal(m);
let fixed=total(m.fixed);
let savings=Math.max(0,income+Number(m.carryover||0)-fixed-spent);

if(savings<goal){

alerts.push(
lang==="ar"
?
"🎯 سرعة التوفير الحالية أقل من هدفك."
:
"🎯 Your current savings pace is below your goal."
);

}
}

if(!alerts.length)
alerts.push(
lang==="ar"
?
"✅ لا توجد تنبيهات مهمة حالياً."
:
"✅ No important alerts right now."
);

box.innerHTML=alerts.map(x=>`
<div class="alert-item">${x}</div>
`).join("");
}


