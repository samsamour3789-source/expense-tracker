let lang=localStorage.getItem("language")||"ar";

let current=
localStorage.getItem("currentMonth")||
new Date().toISOString().slice(0,7);

let data=
JSON.parse(localStorage.getItem("financeData")||"{}");

let settingsData=
JSON.parse(
