let incomeInput=Number(document.getElementById("advisorIncome").value)||0;

let m=monthData();

let income=
incomeInput>0
?
incomeInput
:
getIncomeTotal(m);

let fixed=total(m.fixed);
let debts=0;

(m.debts||[]).forEach(x=>{
debts+=toBase(x.monthly,x.currency);
});

let budget=
m.budget
?
toBase(m.budget.amount,m.budget.currency)
:
0;

let available=
Math.max(
0,
income-fixed-debts
);

let monthlyCost;

if(type==="rent")
monthlyCost=amount;
else
monthlyCost=installment||Math.max(0,amount-down);

let ratio=
income>0
?
monthlyCost/income*100
:
100;

let status;

if(ratio<=25)
status="good";
else if(ratio<=35)
status="warning";
else
status="bad";

let message=
status==="good"
?
t("advisorGood")
:
status==="warning"
?
t("advisorWarning")
:
t("advisorBad");

let colorClass=
status==="good"
?
"green"
:
status==="warning"
?
"gold"
:
"red";

let remaining=
Math.max(
0,
available-monthlyCost
);

document.getElementById("advisorResult").innerHTML=`

<div class="advisor-result">

<div class="row">
<span>${lang==="ar"?"الدخل الشهري":"Monthly income"}</span>
<strong>${money(income)}</strong>
</div>

<div class="row">
<span>${lang==="ar"?"التزاماتك الحالية":"Current obligations"}</span>
<strong>${money(fixed+debts)}</strong>
</div>

<div class="row">
<span>${lang==="ar"?"تكلفة القرار الشهرية":"Monthly decision cost"}</span>
<strong class="${colorClass}">
${money(monthlyCost)}
</strong>
</div>

<div class="row">
<span>${lang==="ar"?"النسبة من الدخل":"Share of income"}</span>
<strong class="${colorClass}">
${Math.round(ratio)}%
</strong>
</div>

<div class="row">
<span>${lang==="ar"?"المتبقي بعد القرار":"Remaining after decision"}</span>
<strong class="green">
${money(remaining)}
</strong>
</div>

<div class="smart">
${message}
</div>

<div class="small">
${
type==="purchase"
?
(lang==="ar"
?
"الحساب تقريبي ويعتمد على المبلغ والقسط المدخلين."
:
"Estimate based on the amount and installment entered.")
:
(lang==="ar"
?
"يفضل أن يبقى الإيجار ضمن نسبة مريحة من الدخل."
:
"Rent should ideally remain within a comfortable share of income.")
}
</div>

</div>

`;
}


