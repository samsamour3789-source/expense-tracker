/* BACKUP */

function backupData(){

let backup={

version:"5.1",

date:new Date().toISOString(),

financeData:data,

settings:settingsData,

accountData:accountData,

language:lang,

currentMonth:current

};

let blob=new Blob(
[
JSON.stringify(backup,null,2)
],
{
type:"application/json"
}
);

let url=URL.createObjectURL(blob);

let a=document.createElement("a");

a.href=url;
a.download="masrofi-backup.json";

document.body.appendChild(a);

a.click();

a.remove();

URL.revokeObjectURL(url);
}

function normalizeMonth(m){

if(!m.fixed)m.fixed=[];
if(!m.expenses)m.expenses=[];
if(!m.incomeSources)m.incomeSources=[];
if(!m.goals)m.goals=[];
if(!m.debts)m.debts=[];
if(m.carryover===undefined)m.carryover=0;
if(m.savingGoal===undefined)m.savingGoal=null;

if(m.baseSavings===undefined)m.baseSavings=null;

return m;
}

function restoreData(event){

let file=event.target.files[0];

if(!file)return;

let reader=new FileReader();

reader.onload=function(e){

try{

let backup=JSON.parse(e.target.result);

if(backup.financeData)
data=backup.financeData;

if(backup.settings)
settingsData=backup.settings;

if(backup.accountData)
accountData=backup.accountData;

if(backup.language)
lang=backup.language;

if(backup.currentMonth)
current=backup.currentMonth;

if(!settingsData.rates)
settingsData.rates={};

if(!settingsData.rates.USD)
settingsData.rates.USD=1;

if(!settingsData.rates.CAD)
settingsData.rates.CAD=1;

if(!settingsData.rates.LBP)
settingsData.rates.LBP=1;

if(!settingsData.rates.SYP)
settingsData.rates.SYP=1;

Object.keys(data).forEach(month=>{
data[month]=normalizeMonth(data[month]);
});

localStorage.setItem(
"financeData",
JSON.stringify(data)
);

localStorage.setItem(
"settings",
JSON.stringify(settingsData)
);

localStorage.setItem(
"accountData",
JSON.stringify(accountData)
);

localStorage.setItem("language",lang);
localStorage.setItem("currentMonth",current);

loadSettings();
applyLanguage();

alert(
lang==="ar"
?
"تم استرجاع النسخة بنجاح ✅"
:
"Backup restored successfully ✅"
);

}
catch(err){

alert(
lang==="ar"
?
"ملف النسخة الاحتياطية غير صالح."
:
"Invalid backup file."
);

}
};

reader.readAsText(file);
}


