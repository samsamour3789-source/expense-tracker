function escape(x){
return String(x).replace(
/[&<>"']/g,
m=>({
"&":"&amp;",
"<":"&lt;",
">":"&gt;",
'"':"&quot;",
"'":"&#039;"
}[m])
);
}

function toUSD(a,c){
let r=Number(settingsData.rates[c]);
return r>0?Number(a)/r:0;
}

function toBase(a,c){
return toUSD(a,c)*
Number(settingsData.rates[settingsData.baseCurrency]||1);
}

function money(a,c=settingsData.baseCurrency){
a=Number(a)||0;

if(c==="USD")return "$"+a.toFixed(2);
if(c==="CAD")return "CA$"+a.toFixed(2);

if(c==="LBP")
return "LBP "+Math.round(a).toLocaleString("en-US");

if(c==="SYP")
return "SYP "+Math.round(a).toLocaleString("en-US");

return c+" "+a.toFixed(2);
}

function total(list){
return list.reduce(
(s,x)=>s+toBase(x.amount,x.currency),
0
);
}

function previousMonthKey(month){
let d=new Date(month+"-01");
d.setMonth(d.getMonth()-1);

return d.getFullYear()+"-"+
String(d.getMonth()+1).padStart(2,"0");
}


/* =====================================================
   MONTH DATA
   ===================================================== */

function monthData(){

if(!data[current]){

let previous=data[previousMonthKey(current)];

let fixed=[];
let carryover=0;
let savingGoal=null;
let baseSavings=null;

if(previous){

if(Array.isArray(previous.fixed)){

fixed=previous.fixed.map(x=>({
...x,
id:Date.now()+Math.floor(Math.random()*100000)
}));

}

/*
الباقي من ميزانية الشهر السابق
ينتقل تلقائياً إلى الشهر الجديد.
*/

let previousBudget=
previous.budget
?
toBase(
previous.budget.amount,
previous.budget.currency
)
:
0;

let previousDaily=
Array.isArray(previous.expenses)
?
total(previous.expenses)
:
0;

carryover=Math.max(
0,
previousBudget-previousDaily
);

if(previous.savingGoal){

savingGoal={
amount:previous.savingGoal.amount,
currency:previous.savingGoal.currency
};

}

/*
الرصيد الأساسي للشهر الجديد =
الرصيد الأساسي للشهر السابق
+
هدف التوفير للشهر السابق.
*/

let previousBaseSavings=0;

if(previous.baseSavings){

previousBaseSavings=toBase(
previous.baseSavings.amount,
previous.baseSavings.currency
);

}

let previousGoal=0;

if(previous.savingGoal){

previousGoal=toBase(
previous.savingGoal.amount,
previous.savingGoal.currency
);

}

baseSavings={
amount:previousBaseSavings+previousGoal,
currency:settingsData.baseCurrency
};

}

data[current]={

income:null,
incomeSources:[],
budget:null,
dailyLimit:null,
fixed:fixed,
expenses:[],
carryover:carryover,
savingGoal:savingGoal,
baseSavings:baseSavings,
goals:[],
debts:[]

};

save();

}

let m=data[current];

if(!Array.isArray(m.fixed))
m.fixed=[];

if(!Array.isArray(m.expenses))
m.expenses=[];

if(!Array.isArray(m.incomeSources))
m.incomeSources=[];

if(!Array.isArray(m.goals))
m.goals=[];

if(!Array.isArray(m.debts))
m.debts=[];

if(m.carryover===undefined)
m.carryover=0;

if(m.savingGoal===undefined)
m.savingGoal=null;

if(m.baseSavings===undefined)
m.baseSavings=null;


/*
=====================================================
الإصلاح الأساسي:
تحديث الباقي المرحّل في كل مرة
بدلاً من حسابه فقط عند إنشاء الشهر.
=====================================================
*/

let previous=data[previousMonthKey(current)];

if(previous){

let previousBudget=
previous.budget
?
toBase(
previous.budget.amount,
previous.budget.currency
)
:
0;

let previousDaily=
Array.isArray(previous.expenses)
?
total(previous.expenses)
:
0;

let newCarryover=Math.max(
0,
previousBudget-previousDaily
);

if(m.carryover!==newCarryover){

m.carryover=newCarryover;

}

/*
هدف التوفير من الشهر السابق
ينتقل تلقائياً للشهر الحالي.
*/

if(previous.savingGoal){

m.savingGoal={
amount:previous.savingGoal.amount,
currency:previous.savingGoal.currency
};

}

save();

}

return m;
}


