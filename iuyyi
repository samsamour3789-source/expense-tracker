/* COMPARISON */

function getMonthSummary(monthKey){

let m=data[monthKey];

if(!m){

return{
income:0,
fixed:0,
daily:0,
total:0,
savings:0
};

}

let income=getIncomeTotal(m);
let fixed=total(m.fixed||[]);
let daily=total(m.expenses||[]);
let expenses=fixed+daily;

let savings=
Math.max(
0,
income+
Number(m.carryover||0)-
fixed-
daily
);

return{
income,
fixed,
daily,
total:expenses,
savings
};

}

function comparisonRow(label,currentValue,previousValue){

let diff=currentValue-previousValue;

let percent=
previousValue!==0
?
diff/previousValue*100
:
0;

let cls=
diff>0
?
"change-up"
:
diff<0
?
"change-down"
:
"";

let sign=
diff>0?"+":"";

return `

<div class="row">

<span>${label}</span>

<strong>

${money(currentValue)}

<br>

<span class="${cls}" style="font-size:11px">
${sign}${money(diff)}
${
previousValue!==0
?
" ("+sign+Math.round(percent)+"%)"
:
""
}
</span>

</strong>

</div>

`;
}

function renderComparison(){

let box=document.getElementById("monthComparison");

let currentSummary=getMonthSummary(current);
let previousSummary=getMonthSummary(previousMonthKey(current));

box.innerHTML=`

<div class="box">

${comparisonRow(
lang==="ar"?"المدخول":"Income",
currentSummary.income,
previousSummary.income
)}

${comparisonRow(
lang==="ar"?"المصاريف الثابتة":"Fixed expenses",
currentSummary.fixed,
previousSummary.fixed
)}

${comparisonRow(
lang==="ar"?"المصاريف اليومية":"Daily expenses",
currentSummary.daily,
previousSummary.daily
)}

${comparisonRow(
lang==="ar"?"إجمالي المصاريف":"Total expenses",
currentSummary.total,
previousSummary.total
)}

${comparisonRow(
lang==="ar"?"التوفير":"Savings",
currentSummary.savings,
previousSummary.savings
)}

</div>

<div class="small">
${
lang==="ar"
?
"الأرقام الحالية مقارنة بالشهر السابق."
:
"Current figures compared with the previous month."
}
</div>
`;
